      "name": "GetRooms",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Проверяем, что сервер ответил успешно\r",
              "pm.test(\"Статус код 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Проверяем, что пришел массив (как в контракте)\r",
              "pm.test(\"Ответ является массивом\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.be.an('array');\r",
              "});\r",
              "\r",
              "// 3. Проверяем данные первой комнаты\r",
              "pm.test(\"Данные комнаты Альфа корректны\", function () {\r",
              "    var firstRoom = pm.response.json()[0];\r",
              "    pm.expect(firstRoom.id).to.eql(1);\r",
              "    pm.expect(firstRoom.name).to.eql(\"Альфа\");\r",
              "    pm.expect(firstRoom.equipment).to.be.an('array').that.includes(\"Проектор\");\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
